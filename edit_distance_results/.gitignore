# Ignore temporary files and logs
*.log
*.tmp
*.out

# Ignore test scripts
test_*.sh
debug_*.sh
analyze_*.sh
check_*.sh
find_*.sh
run_*.sh

# Ignore data files (should be in parent data directory)
data/

# Ignore tool binaries (these should be in the user's path)
seqproc
matchbox
splitcode

# Ignore Python cache
__pycache__/
*.pyc

# Ignore temporary directories
tmp/
temp/
*.tmpdir
