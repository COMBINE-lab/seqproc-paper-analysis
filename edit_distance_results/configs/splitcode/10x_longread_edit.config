# 10x Chromium long-read config for splitcode with EDIT DISTANCE
# Structure: [_][primer:22][barcode:16][umi:12][_]
# Primer: CTACACGACGCTCTTCCGATCT
# Using edit distance format: mismatch:indel:total
# Matchbox uses -e 0.2 = 4 edits for 22bp primer
ID	TAG	GROUP	DISTANCE	NEXT
primer	CTACACGACGCTCTTCCGATCT	primer	2:2:4	-
primer_rc	AGATCGGAAGAGCGTCGTGTAG	primer_rc	2:2:4	-

@extract {primer}<barcode[16]><umi[12]>
@extract <umi_rc[12]><barcode_rc[16]>{primer_rc}
