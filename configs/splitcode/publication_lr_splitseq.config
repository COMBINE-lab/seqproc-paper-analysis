# Forward-orientation LR-SPLiT-seq anchor benchmark. The linkers are separated
# by BC2 (8 nt); extracted UMI/barcodes are not whitelist-filtered.
ID	TAG	GROUP	DISTANCE	NEXT
linker1	GTGGCCGATGTTTCGCATCGGCGTACGACT	linker1	3	{linker2}8
linker2	ATCCACGTGCTTGAGACTGTGG	linker2	3	-
@extract <prefix[18]>{linker1}
@extract {linker1}<bc2[8]>
@extract {linker2}<bc1[8]>
