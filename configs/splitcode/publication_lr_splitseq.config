# Forward-orientation LR-SPLiT-seq anchor benchmark. The linkers are separated
# by BC2 (8 nt); extracted UMI/barcodes are not whitelist-filtered. Both
# linkers are required, linker1 cannot begin before the 18-nt UMI+BC3 prefix,
# and repeated hits do not concatenate multiple logical products.
ID	TAG	GROUP	DISTANCE	NEXT	MINFINDSG	LOCATION
linker1	GTGGCCGATGTTTCGCATCGGCGTACGACT	linker1	3	{linker2}8	1	0:18
linker2	ATCCACGTGCTTGAGACTGTGG	linker2	3	-	1	-
@no-chain
@extract <prefix[18]>{linker1}
@extract {linker1}<bc2[8]>
@extract {linker2}<bc1[6]>
