# Semantically aligned SPLiT-seq PE benchmark: retain accepted R1 and emit
# UMI+BC3+BC2+BC1 in R2, matching the seqproc output geometry.
l1 = GTGGCCGCTGTTTCGCATCGGCGTACGACT
l2 = ATCCACGTGCTTGAGAGGCCAGAGCATTCG
bcs1 = csv('configs/matchbox/rt_6bp.csv')
bcs23 = csv('configs/matchbox/r2_r3.txt')

if read.r2 matches {
    [_ umi:|8| bc3_hit:bc3.round_23~0.13 l1~0.1 bc2_hit:bc2.round_23~0.13 l2~0.1 bc1_hit:bc1.barcode~0.17 _]
        for bc1 in bcs1, bc2 in bcs23, bc3 in bcs23 => {
            read.r1.out!('mb_r1.fq')
            # Balance concatenation to minimize intermediate copied bases.
            (umi.concat(bc3_hit)).concat(bc2_hit.concat(bc1_hit)).out!('mb_r2.fq')
        }
}
