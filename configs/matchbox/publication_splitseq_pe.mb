# Corrected physical PE layout; see publication_splitseq_pe.geom. Matchbox's
# approximate regions can move an adjacent field boundary even for an exact
# cassette, so this best-practical native configuration uses exact canonical
# barcodes and linkers. The accuracy analysis reports this capability difference.
l1 = GTGGCCGATGTTTCGCATCGGCGTACGACT
l2 = ATCCACGTGCTTGAGAGGCCAGAGCATTCG
bcs23 = csv('configs/matchbox/r2_r3.txt')

if read.r2 matches {
    [umi:|10| bc3_hit:bc3.round_23~0.0 l1~0.0 bc2_hit:bc2.round_23~0.0 l2~0.0 bc1_hit:bc1.round_23~0.0 _]
        for bc1 in bcs23, bc2 in bcs23, bc3 in bcs23 => {
            read.r1.out!('mb_r1.fq')
            # Balance concatenation to minimize intermediate copied bases.
            (umi.concat(bc3_hit)).concat(bc2_hit.concat(bc1_hit)).out!('mb_r2.fq')
        }
}
