# Semantically aligned 10x v2 benchmark: reject pairs whose R1 is shorter
# than the 16-base barcode plus 10-base UMI, otherwise pass both reads through
# unchanged. Avoid materializing unused BC/UMI captures for this filter-only
# workload.
if read.r1.seq.len() >= 26 {
    read.r1.out!('mb_r1.fq')
    read.r2.out!('mb_r2.fq')
}
