linker1 = GTGGCCGCTGTTTCGCATCGGCGTACGACT
# L2 truncated to 22bp -- matchbox global -e 0.2 cannot match full 30bp on
# noisy PacBio long reads (1K vs 355K recovered). First 22bp is sufficient anchor.
linker2 = ATCCACGTGCTTGAGAGGCCAG

if read matches {
    [_ umi:|10| bc3:|8| linker1 bc2:|8| linker2 bc1:|6| rest:_] =>
        '{read.id}\t{bc1.seq}\t{bc2.seq}\t{bc3.seq}\t{umi.seq}'.stdout!()
    [rest:_ bc1:|6| -linker2 bc2:|8| -linker1 bc3:|8| umi:|10| _] =>
        '{read.id}\t{-bc1.seq}\t{-bc2.seq}\t{-bc3.seq}\t{-umi.seq}'.stdout!()
}
