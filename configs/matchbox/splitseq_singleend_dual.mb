# LR-SPLiT-seq (micro-SPLiT) uses different linker sequences than the PE protocol.
# L1 has an A at position 8 (GTGGCCGAT..., not the PE GTGGCCGCT...), and L2 is
# ATCCACGTGCTTGAGACTGTGG. These are the sequences actually present in the LR reads;
# the PE linkers (used previously here) are absent from SRR13948564 (L2 matched 0
# of 2M reads), which was crippling matchbox's LR recovery.
# bc1 (round-1 RT barcode) is the full 8bp on long reads; the 6bp form is the PE
# truncation (94bp read has no room). seqproc/splitcode already use 8bp; this fixes
# matchbox to match, so the LR comparison extracts the same barcode for all tools.
linker1 = GTGGCCGATGTTTCGCATCGGCGTACGACT
linker2 = ATCCACGTGCTTGAGACTGTGG

if read matches {
    [_ umi:|10| bc3:|8| linker1 bc2:|8| linker2 bc1:|8| rest:_] =>
        '{read.id}\t{bc1.seq}\t{bc2.seq}\t{bc3.seq}\t{umi.seq}'.stdout!()
    [rest:_ bc1:|8| -linker2 bc2:|8| -linker1 bc3:|8| umi:|10| _] =>
        '{read.id}\t{-bc1.seq}\t{-bc2.seq}\t{-bc3.seq}\t{-umi.seq}'.stdout!()
}
