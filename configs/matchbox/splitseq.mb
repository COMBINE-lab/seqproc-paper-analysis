# Matchbox SPLiT-seq barcode extraction script
# Structure: [_][UMI:8][BC3:8][Linker1:30][BC2:8][Linker2:30][BC1:6]
# NOTE: matchbox cannot match umi:|10| (pattern matching bug), so we use umi:|8|
# and absorb the extra 2bp into the skip. UMI is just a tag, not validated.
#
# Linker sequences (GCT variant for SRR6750041):
#   Linker1: GTGGCCGCTGTTTCGCATCGGCGTACGACT (30bp)
#   Linker2: ATCCACGTGCTTGAGAGGCCAGAGCATTCG (30bp)

linker1 = GTGGCCGCTGTTTCGCATCGGCGTACGACT
linker2 = ATCCACGTGCTTGAGAGGCCAGAGCATTCG

if read matches [_ umi:|8| bc3:|8| linker1~0.2 bc2:|8| linker2~0.2 bc1:|6| _] => {
    '{read.id}\t{bc1.seq}\t{bc2.seq}\t{bc3.seq}\t{umi.seq}'.stdout!()
}
