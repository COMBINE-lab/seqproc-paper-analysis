# Sensitivity-only SPLiT-seq PE configuration.  It expands the canonical
# 96-member 8-nt whitelist to all unique Hamming-distance-one observations and
# matches those variants exactly.  This avoids Matchbox's approximate-capture
# boundary shifts while emulating the barcode acceptance radius used by
# seqproc and splitcode.  Linkers remain exact, so this is not fully equivalent
# to their edit/substitution-distance-three linker configurations.
l1 = GTGGCCGATGTTTCGCATCGGCGTACGACT
l2 = ATCCACGTGCTTGAGAGGCCAGAGCATTCG
bcs23 = csv('configs/diagnostics/splitseq_pe_bc8_ham1.csv')

if read.r2 matches {
    [umi:|10| bc3_hit:bc3.barcode~0.0 l1~0.0 bc2_hit:bc2.barcode~0.0 l2~0.0 bc1_hit:bc1.barcode~0.0 _]
        for bc1 in bcs23, bc2 in bcs23, bc3 in bcs23 => {
            read.r1.out!('mb_r1.fq')
            (umi.concat(bc3_hit)).concat(bc2_hit.concat(bc1_hit)).out!('mb_r2.fq')
        }
}
