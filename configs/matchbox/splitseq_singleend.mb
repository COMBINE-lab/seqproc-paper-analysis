# Matchbox SPLiT-seq barcode extraction script (SINGLE-END)
# Dataset: SRR13948564
# Structure: [UMI:10][BC3:8][Linker1:30][BC2:8][Linker2:30][BC1:8][rest]
#
# Linker sequences:
#   Linker1: GTGGCCGCTGTTTCGCATCGGCGTACGACT (30bp)
#   Linker2: ATCCACGTGCTTGAGAGGCCAGAGCATTCG (30bp)

linker1 = GTGGCCGCTGTTTCGCATCGGCGTACGACT
linker2 = ATCCACGTGCTTGAGAGGCCAGAGCATTCG

if read matches [umi:|10| bc3:|8| linker1~0.2 bc2:|8| linker2~0.2 bc1:|6| _] => {
    '{read.id}\t{bc1.seq}\t{bc2.seq}\t{bc3.seq}\t{umi.seq}'.stdout!()
}
